# RecoveryOS backend environment placeholders.
# Copy to .env and fill in real values. Do not commit .env.

# --- FastAPI ---
# APP_ENV=development
# HOST=0.0.0.0
# PORT=8000

# --- Razorpay Test Mode (bounded execution) ---
# Credentials for REAL_RAZORPAY Payment Link execution. They come from the
# environment and are never hardcoded or committed. When unset, payment_link
# execution reports an explicit configuration_missing failure.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Razorpay webhook secret for verifying payment_link.paid delivery signatures.
# This is a SEPARATE secret from the API key secret (chosen in the Razorpay
# Dashboard webhook settings) and is used for HMAC-SHA256 verification over the
# raw webhook body. Never commit a real value and never store it in SQLite.
# When unset, incoming webhooks fail verification (fail-closed).
# RAZORPAY_WEBHOOK_SECRET=

# --- OmniRoute (AI classifier) ---
# The API key for the OmniRoute model access layer used by the advisory AI
# classifier. Never commit a real key.
# OMNIROUTE_API_KEY=
# The model identifier is externalized through configuration; do not hardcode
# model names in business logic.
# OMNIROUTE_MODEL=
# Base URL of the OmniRoute OpenAI-compatible endpoint.
# OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1

# --- Policy (deterministic safety gate) ---
# Max intervention attempts per customer within a rolling 24h window.
# POLICY_MAX_INTERVENTIONS_PER_CUSTOMER_24H=2
# Minimum minutes that must elapse between interventions on the same event.
# POLICY_EVENT_COOLDOWN_MINUTES=30
# Daily spend cap in paise for all interventions within a rolling 24h window.
# POLICY_DAILY_SPEND_CAP_PAISE=5000000

# --- Database (SQLite) ---
# The SQLite database path used by the application. If unset, defaults to
# sqlite:///./recoveryos.db (a local development database).
# DATABASE_URL=sqlite:///./recoveryos.db
