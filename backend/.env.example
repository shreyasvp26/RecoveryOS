# RecoveryOS backend environment placeholders (Phase 1 foundation).
# Copy to .env and fill in real values in later phases. Do not commit .env.

# --- FastAPI ---
# APP_ENV=development
# HOST=0.0.0.0
# PORT=8000

# --- Razorpay Test Mode (future) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- OmniRoute (future) ---
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=

# --- Database (SQLite) ---
# The SQLite database path used by the application. If unset, defaults to
# sqlite:///./recoveryos.db (a local development database).
# DATABASE_URL=sqlite:///./recoveryos.db
